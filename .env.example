# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- App ---
APP_NAME=smart-water-monitor
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smart_water

# --- MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fastapi-backend
MQTT_TOPIC_SENSOR=home/+/+/sensor
MQTT_TOPIC_ALERT=home/+/+/alert
MQTT_TOPIC_STATUS=home/+/+/status

# --- Admin API key (required in APP_ENV != development) ---
# Protects POST /api/devices/register, /simulate, /reset.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- CORS ---
# Comma-separated list of dashboard origins allowed to call this API.
# Never set this to * -- allow_credentials=True is on, and combining a
# wildcard origin with credentials effectively disables CORS protection.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alert thresholds ---
ALERT_DURATION_THRESHOLD_SEC=300
